<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>tea-dnd-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>tea-dnd-teavm</artifactId>
  <dependencies>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>gwt-user-compat</artifactId>
      <version>${compat.version}</version>
    </dependency>
  </dependencies>
  <build>
    <sourceDirectory>${project.build.directory}/teavm-sources</sourceDirectory>
    <resources>
      <resource>
        <directory>..</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>NOTICE</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>io.instanto</groupId>
        <artifactId>gwt-resources-compat-maven-plugin</artifactId>
        <version>${compat.version}</version>
        <executions>
          <execution>
            <id>adapt</id>
            <goals>
              <goal>adapt-sources</goal>
            </goals>
            <configuration>
              <sourceRoot>${project.basedir}/../tea-dnd-gwt/src/main/java</sourceRoot>
              <legacyJsni>true</legacyJsni>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
