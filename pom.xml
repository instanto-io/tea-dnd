<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>instanto-teavm-pom</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath/>
  </parent>
  <groupId>io.instanto</groupId>
  <artifactId>tea-dnd-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Tea DnD</name>
  <description>GWT drag and drop for modern GWT and TeaVM</description>
  <url>https://github.com/instanto-io/tea-dnd</url>
  <licenses>
    <license>
      <name>Apache License 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>
  <scm>
    <url>https://github.com/instanto-io/tea-dnd</url>
    <connection>scm:git:https://github.com/instanto-io/tea-dnd.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/instanto-io/tea-dnd.git</developerConnection>
    <tag>HEAD</tag>
  </scm>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <gwt.version>2.13.1</gwt.version>
    <compat.version>0.1.0-SNAPSHOT</compat.version>
    <teavm.optimization>SIMPLE</teavm.optimization>
    <gwt.style>PRETTY</gwt.style>
  </properties>
  <modules>
    <module>tea-dnd-gwt</module>
    <module>tea-dnd-teavm</module>
    <module>tea-dnd-showcase-gwt</module>
    <module>tea-dnd-showcase-teavm</module>
  </modules>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
        <configuration>
          <proc>none</proc>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>high-priority-analysis-gate</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <failThreshold>High</failThreshold>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>production</id>
      <properties>
        <teavm.optimization>ADVANCED</teavm.optimization>
        <gwt.style>OBF</gwt.style>
      </properties>
    </profile>
  </profiles>
</project>
